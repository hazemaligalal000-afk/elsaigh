            .jm-mobile-floating-cta{box-sizing:border-box;transition:opacity 160ms ease-out;backface-visibility:hidden;padding:8px max(16px,env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left));}
            .jm-mobile-floating-cta .jm-floating-button{width:100%;max-width:358px;margin:0 auto;pointer-events:auto;}
            .jm-mobile-floating-cta .jm-floating-button>div{width:100%!important;height:auto!important;}
            .jm-mobile-floating-cta .jm-floating-button a{position:relative!important;inset:auto!important;transform:none!important;width:100%!important;height:48px!important;min-height:48px!important;padding:12px 18px!important;border-radius:8px!important;box-shadow:0 4px 18px rgba(15,65,94,.18)!important;}
            .jm-mobile-floating-cta .jm-floating-button p{font-size:16px!important;line-height:24px!important;}
            .jm-mobile-floating-cta .jm-floating-button a:focus-visible{outline:2px solid #0f415e;outline-offset:3px;}
            .jm-mobile-floating-cta[data-visible="false"] .jm-floating-button{pointer-events:none;}
            @media(prefers-reduced-motion:reduce){.jm-mobile-floating-cta{transition:none;}}
