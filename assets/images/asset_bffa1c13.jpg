<style>

  /* =========================================
     JAWHARA POPUP
  ========================================= */

  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE {
    position: relative;
    z-index: 999999;
  }


  /* =========================================
     OVERLAY
  ========================================= */

  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-overlay {

    position: fixed;

    inset: 0;

    width: 100%;
    height: 100%;

    background: rgba(0, 0, 0, 0.45);

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 20px;

    box-sizing: border-box;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transition:
      opacity 0.35s ease,
      visibility 0.35s ease;

  }


  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-overlay.is-visible {

    opacity: 1;

    visibility: visible;

    pointer-events: auto;

  }


  /* =========================================
     POPUP BOX
  ========================================= */

  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup {

    position: relative;

    width: min(520px, 100%);

    background: #ffffff;

    color: #111111;

    padding: 52px 45px 45px;

    text-align: center;

    border-radius: 2px;

    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.20);

    box-sizing: border-box;

    transform: translateY(20px) scale(0.97);

    transition:
      transform 0.4s ease;

  }


  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-overlay.is-visible .jawhara-popup {

    transform: translateY(0) scale(1);

  }


  /* =========================================
     CLOSE BUTTON
  ========================================= */

  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-close {

    position: absolute;

    top: 13px;
    right: 16px;

    width: 34px;
    height: 34px;

    padding: 0;

    border: none;

    background: transparent;

    color: #111111;

    font-size: 30px;

    font-weight: 300;

    line-height: 30px;

    cursor: pointer;

    opacity: 0.6;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;

  }


  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-close:hover {

    opacity: 1;

    transform: rotate(90deg);

  }


  /* =========================================
     BRAND
  ========================================= */

  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-brand {

    margin: 0 0 22px;

    font-family: inherit;

    font-size: 28px;

    font-weight: 500;

    letter-spacing: 1px;

    line-height: 1.2;

    color: #111111;

  }


  /* =========================================
     18K GOLD
  ========================================= */

  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-gold {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    margin-bottom: 27px;

    font-family: inherit;

    font-size: 19px;

    font-weight: 500;

    letter-spacing: 0.5px;

  }


  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-sparkle {

    font-size: 19px;

  }


  /* =========================================
     MESSAGE
  ========================================= */

  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-message {

    max-width: 410px;

    margin: 0 auto;

  }


  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-message p {

    margin: 0 0 18px;

    font-family: inherit;

    font-size: 15px;

    font-weight: 400;

    line-height: 1.65;

    letter-spacing: 0.1px;

  }


  /* =========================================
     THANK YOU
  ========================================= */

  #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-thankyou {

    margin: 25px 0 0;

    font-family: inherit;

    font-size: 14px;

    font-weight: 400;

    line-height: 1.5;

  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-overlay {

      padding: 18px;

    }


    #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup {

      width: 100%;

      padding: 44px 25px 38px;

      border-radius: 2px;

    }


    #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-brand {

      font-size: 25px;

      margin-bottom: 18px;

    }


    #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-gold {

      font-size: 18px;

      margin-bottom: 22px;

    }


    #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-sparkle {

      font-size: 18px;

    }


    #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-message p {

      font-size: 14px;

      line-height: 1.6;

      margin-bottom: 15px;

    }


    #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-thankyou {

      font-size: 14px;

      margin-top: 20px;

    }


    #jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE .jawhara-popup-close {

      top: 10px;

      right: 12px;

      font-size: 27px;

    }

  }

</style>


<script>

  (function () {

    const section = document.getElementById(
      'jawhara-popup-sections--28528407937338__jawhara_popup_qNzwzE'
    );

    if (!section) return;


    const overlay = section.querySelector(
      '.jawhara-popup-overlay'
    );

    const closeButton = section.querySelector(
      '.jawhara-popup-close'
    );


    const enabled =
      section.dataset.enabled === 'true';


    const delay =
      parseInt(
        section.dataset.delay || '1500',
        10
      );


    /*
      Popup appears only once
      during the current browser session.
    */

    const storageKey =
      'jawhara_gold_popup_seen';


    function openPopup() {

      overlay.classList.add(
        'is-visible'
      );

      overlay.setAttribute(
        'aria-hidden',
        'false'
      );

      document.body.style.overflow =
        'hidden';


      try {

        sessionStorage.setItem(
          storageKey,
          'true'
        );

      } catch (error) {

        console.log(
          'Jawhara popup storage unavailable'
        );

      }

    }


    function closePopup() {

      overlay.classList.remove(
        'is-visible'
      );

      overlay.setAttribute(
        'aria-hidden',
        'true'
      );

      document.body.style.overflow =
        '';

    }


    /*
      Stop if popup is disabled.
    */

    if (!enabled) return;


    /*
      Check if popup was already shown
      in this browser session.
    */

    let alreadySeen = false;


    try {

      alreadySeen =
        sessionStorage.getItem(
          storageKey
        ) === 'true';

    } catch (error) {

      alreadySeen = false;

    }


    /*
      Show popup after delay.
    */

    if (!alreadySeen) {

      setTimeout(function () {

        openPopup();

      }, delay);

    }


    /*
      Close button.
    */

    closeButton.addEventListener(
      'click',
      function () {

        closePopup();

      }
    );


    /*
      Close when clicking outside.
    */

    overlay.addEventListener(
      'click',
      function (event) {

        if (
          event.target === overlay
        ) {

          closePopup();

        }

      }
    );


    /*
      Close with ESC.
    */

    document.addEventListener(
      'keydown',
      function (event) {

        if (
          event.key === 'Escape' &&
          overlay.classList.contains(
            'is-visible'
          )
        ) {

          closePopup();

        }

      }
    );

  })();

</script>


</section>
