      width: 8px;
      height: 8px;
    }

  }

</style>


<script>

(function() {

  function initHeroCarousel() {

    const carousel =
      document.querySelector(
        '#HeroCarousel-template--28528413671738__custom_hero_carsoul_d66KKD'
      );


    if (!carousel) return;


    /*
      Prevent duplicate initialization.
    */

    if (
      carousel.dataset.initialized === 'true'
    ) {
      return;
    }


    carousel.dataset.initialized = 'true';


    const slides =
      carousel.querySelectorAll(
        '.hero-carousel__slide'
      );


    const dots =
      carousel.querySelectorAll(
        '.hero-carousel__dot'
      );


    const nextButton =
      carousel.querySelector(
        '.hero-carousel__arrow--next'
      );


    const prevButton =
      carousel.querySelector(
        '.hero-carousel__arrow--prev'
      );


    if (!slides.length) return;


    let currentSlide = 0;

    let autoplayTimer = null;

    let preloadTimer = null;


    const autoplay =
      carousel.dataset.autoplay === 'true';


    const speed =
      parseInt(
        carousel.dataset.speed,
        10
      ) || 5000;


    /*
      ======================================================
      LOAD VIDEO
      ======================================================
    */

    function loadVideo(video, preload) {

      if (!video) return;


      /*
        Already loaded.
      */

      if (
        video.dataset.loaded === 'true'
      ) {
        return;
      }


      const url =
        video.dataset.videoUrl;


      if (!url) return;


      /*
        Set source directly.

        This is intentionally done with
        the Shopify Files CDN URL.
      */

      video.src = url;


      if (preload) {

        video.preload = 'auto';

      } else {

        video.preload = 'metadata';

      }


      video.dataset.loaded = 'true';


      /*
        Tell browser to start loading.
      */

      try {

        video.load();

      } catch (error) {}

    }


    /*
      ======================================================
      PLAY VIDEO
      ======================================================
    */

    function playVideo(video) {

      if (!video) return;


      loadVideo(
        video,
        true
      );


      video.muted = true;


      video.setAttribute(
        'muted',
        ''
      );


      video.setAttribute(
        'playsinline',
        ''
      );


      video.setAttribute(
        'webkit-playsinline',
        ''
      );


      function start() {

        const playPromise =
          video.play();


        if (
          playPromise &&
          typeof playPromise.catch === 'function'
        ) {

          playPromise.catch(
            function() {}
          );

        }

      }


      /*
        If video is ready, play immediately.
      */

      if (
        video.readyState >= 2
      ) {

        start();

      } else {

        video.addEventListener(
          'canplay',
          start,
          {
            once: true
          }
        );

      }

    }


    /*
      ======================================================
      PAUSE ALL OTHER VIDEOS
      ======================================================
    */

    function pauseOtherVideos(
      activeIndex
    ) {

      slides.forEach(
        function(slide, index) {

          if (
            index === activeIndex
          ) {
            return;
          }


          const video =
            slide.querySelector(
              'video'
            );


          if (!video) return;


          try {

            video.pause();

          } catch (error) {}

        }
      );

    }


    /*
      ======================================================
      PRELOAD NEXT VIDEO
      ======================================================
    */

    function preloadNextVideo(
      activeIndex
    ) {

      if (
        slides.length <= 1
      ) {
        return;
      }


      clearTimeout(
        preloadTimer
      );


      preloadTimer =
        setTimeout(
          function() {

            const nextIndex =
              (
                activeIndex + 1
              ) % slides.length;


            const nextSlide =
              slides[nextIndex];


            if (!nextSlide) return;


            const nextVideo =
              nextSlide.querySelector(
                'video'
              );


            if (!nextVideo) return;


            loadVideo(
              nextVideo,
              false
            );

          },
          1200
        );

    }


    /*
      ======================================================
      SHOW SLIDE
      ======================================================
    */

    function showSlide(index) {

      if (!slides.length) {
        return;
      }


      if (
        index >= slides.length
      ) {

        index = 0;

      }


      if (
        index < 0
      ) {

        index =
          slides.length - 1;

      }


      /*
        Change slide.
      */

      slides.forEach(
        function(slide, i) {

          slide.classList.toggle(
            'is-active',
            i === index
          );

        }
      );


      /*
        Change dots.
      */

      dots.forEach(
        function(dot, i) {

          dot.classList.toggle(
            'is-active',
            i === index
          );

        }
      );


      currentSlide = index;


      /*
        Pause other videos.
      */

      pauseOtherVideos(
        index
      );


      /*
        Play active video.
      */

      const activeSlide =
        slides[index];


      const activeVideo =
        activeSlide.querySelector(
          'video'
        );


      if (activeVideo) {

        try {

          activeVideo.currentTime = 0;

        } catch (error) {}


        playVideo(
          activeVideo
        );

      }


      /*
        Prepare next video.
      */

      preloadNextVideo(
        index
      );


      /*
        Restart autoplay.
      */

      restartAutoplay();

    }


    /*
      ======================================================
      NEXT SLIDE
      ======================================================
    */

    function nextSlide() {

      showSlide(
        currentSlide + 1
      );

    }


    /*
      ======================================================
      PREVIOUS SLIDE
      ======================================================
    */

    function previousSlide() {

      showSlide(
        currentSlide - 1
      );

    }


    /*
      ======================================================
      AUTOPLAY
      ======================================================
    */

    function restartAutoplay() {

      if (
        !autoplay ||
        slides.length <= 1
      ) {
        return;
      }


      clearInterval(
        autoplayTimer
      );


      autoplayTimer =
        setInterval(
          function() {

            nextSlide();

          },
          speed
        );

    }


    /*
      ======================================================
      ARROWS
      ======================================================
    */

    if (nextButton) {

      nextButton.addEventListener(
        'click',
        function() {

          nextSlide();

        }
      );

    }


    if (prevButton) {

      prevButton.addEventListener(
        'click',
        function() {

          previousSlide();

        }
      );

    }


    /*
      ======================================================
      DOTS
      ======================================================
    */

    dots.forEach(
      function(dot) {

        dot.addEventListener(
          'click',
          function() {

            const index =
              parseInt(
                this.dataset.slideTo,
                10
              );


            if (
              !isNaN(index)
            ) {

              showSlide(
                index
              );

            }

          }
        );

      }
    );


    /*
      ======================================================
      SWIPE
      ======================================================
    */

    let touchStartX = 0;


    carousel.addEventListener(
      'touchstart',
      function(e) {

        if (
          e.changedTouches &&
          e.changedTouches.length
        ) {

          touchStartX =
            e.changedTouches[0].screenX;

        }

      },
      {
        passive: true
      }
    );


    carousel.addEventListener(
      'touchend',
      function(e) {

        if (
          !e.changedTouches ||
          !e.changedTouches.length
        ) {
          return;
        }


        const touchEndX =
          e.changedTouches[0].screenX;


        const difference =
          touchStartX - touchEndX;


        if (
          Math.abs(difference) > 50
        ) {

          if (
            difference > 0
          ) {

            nextSlide();

          } else {

            previousSlide();

          }

        }

      },
      {
        passive: true
      }
    );


    /*
      ======================================================
      START
      ======================================================
    */

    showSlide(0);

  }


  /*
    ========================================================
    INITIALIZE
    ========================================================
  */

  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initHeroCarousel
    );

  } else {

    initHeroCarousel();

  }


  /*
    ========================================================
    SHOPIFY THEME EDITOR
    ========================================================
  */

  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.detail &&
        event.detail.sectionId ===
          'template--28528413671738__custom_hero_carsoul_d66KKD'
      ) {

        initHeroCarousel();

      }

    }
  );

})();

</script>


