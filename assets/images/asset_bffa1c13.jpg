  <script>
    document.addEventListener('instafeedAppLoaded', (event) => {
      var feedId = 0;
      if (!event.detail || !event.detail.account || event.detail.feedId !== feedId) return;
      const link = document.querySelector('.instafeed-bottom-link-wrapper[data-feed-id="' + feedId + '"] a');
      if (link) {
        const account = String(event.detail.account || '');
        if (!/^[a-zA-Z0-9._]+$/.test(account)) return;
        link.href = 'https://www.instagram.com/' + account + '/';
        link.textContent = '@' + account;
        link.style.display = 'inline-block';
      }
    });
  </script>




